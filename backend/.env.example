# Copy to .env and fill in real values. Never commit .env.

# Used by docker-compose.yml for the postgres service, and to build
# DATABASE_URL for the api service automatically.
POSTGRES_PASSWORD=change-me

# Used directly when running the backend outside Docker (bun run dev) or by
# scripts/migrate.ts and scripts/create-user.ts.
DATABASE_URL=postgres://postgres:change-me@localhost:5432/money_manager

# Generate with: openssl rand -base64 48
JWT_SECRET=

PORT=3000

# Origin of the deployed web app (see ../app/Dockerfile.web + docker-compose.yml's
# `web` service), e.g. https://app.example.com. CORS is off (no browser
# access) if this is unset — the mobile app doesn't need it, only the
# browser-based web app does.
WEB_ORIGIN=
